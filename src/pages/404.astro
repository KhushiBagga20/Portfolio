---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import FloppyDisk from '../components/FloppyDisk.astro';
import { site } from '../data/site';
---

<Base title={`Disk not found · ${site.fullName}`} noindex>
  <Nav />
  <main class="lost">
    <section class="dialog" aria-labelledby="lost-title">
      <div class="dialog__bar">
        <span>error.exe</span>
        <span class="dialog__dots" aria-hidden="true"><i></i><i></i><i></i></span>
      </div>
      <div class="dialog__body">
        <div class="dialog__disk">
          <FloppyDisk tone="lilac" scribble="???" />
        </div>
        <div>
          <p class="dialog__code">error 404</p>
          <h1 id="lost-title">disk not found</h1>
          <p class="dialog__text">This page isn't on any of my disks. It may have moved, or it never existed.</p>
          <div class="dialog__actions">
            <a class="key key--tomato" href="/">take me home</a>
            <a class="key" href="/#projects">see projects</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .lost {
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: 104px var(--gutter) 64px;
  }

  .dialog {
    width: min(100%, 760px);
    border: var(--line) solid var(--ink);
    border-radius: 20px;
    background: var(--cream);
    box-shadow: 12px 14px 0 var(--ink);
    rotate: -1deg;
  }

  .dialog__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: var(--line) solid var(--ink);
    border-radius: 17px 17px 0 0;
    background: var(--lemon);
    font: 400 11px/1 var(--font-pixel);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .dialog__dots {
    display: flex;
    gap: 5px;
  }

  .dialog__dots i {
    width: 11px;
    height: 11px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--cream);
  }

  .dialog__body {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    align-items: center;
    gap: clamp(24px, 4vw, 44px);
    padding: clamp(24px, 4vw, 44px);
  }

  .dialog__disk {
    rotate: -8deg;
    animation: wobble 3.2s ease-in-out infinite alternate;
  }

  @keyframes wobble {
    to {
      rotate: 6deg;
      translate: 0 -6px;
    }
  }

  .dialog__code {
    margin: 0;
    color: var(--ink-soft);
    font: 400 11px/1 var(--font-pixel);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h1 {
    margin: 10px 0 0;
    color: var(--lemon);
    font: 400 clamp(44px, 6vw, 72px) / 0.92 var(--font-display);
    -webkit-text-stroke: 0.07em var(--ink);
    paint-order: stroke fill;
    text-shadow:
      0.035em 0.045em 0 var(--ink),
      0.065em 0.08em 0 var(--tomato);
  }

  .dialog__text {
    max-width: 36ch;
    margin: 16px 0 0;
    color: var(--text-soft);
    font-size: 18px;
  }

  .dialog__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  @media (max-width: 599px) {
    .dialog__body {
      grid-template-columns: minmax(0, 1fr);
      justify-items: start;
    }

    .dialog__disk {
      width: 140px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dialog__disk {
      animation: none;
    }
  }
</style>
