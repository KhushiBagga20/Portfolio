---
import '@fontsource/bagel-fat-one/latin-400.css';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/silkscreen/latin-400.css';
import '@fontsource/delicious-handrawn/latin-400.css';
import '../styles/global.css';
import { site } from '../data/site';
import { about, education } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = site.title, description = site.description, noindex = false } = Astro.props;

// Absolute URLs need `site` in astro.config.mjs (set it once the domain exists).
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.fullName,
  ...(Astro.site && { url: Astro.site.href }),
  email: site.links.email ? `mailto:${site.links.email}` : undefined,
  sameAs: [site.links.linkedin, site.links.github].filter(Boolean),
  affiliation: { '@type': 'CollegeOrUniversity', name: education.school },
  knowsAbout: about.interests,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    <meta name="theme-color" content="#b9c6ff" />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.fullName}: ${site.headline}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <slot />
  </body>
</html>
