---
// PLACEHOLDER: one card per keyboard section, so every key has somewhere to go.
// Each will grow into a real section once the content exists. No invented entries.
import { sections, tones } from '../data/keyboard';

const notes: Record<string, string> = {
  about: 'Who you are, what you love, and what you are learning right now.',
  projects: 'Each project: what it does, why you built it, how, the stack, your role, screenshots and links.',
  skills: 'AI, frontend, programming, design, and everything in between. No percentage bars.',
  writing: 'Essays, AI ethics pieces, technical writing and creative writing.',
  experience: 'Hackathons, competitions, certifications, achievements and education.',
  contact: 'Email, GitHub, LinkedIn and your résumé.',
};
---

<section class="sections" aria-labelledby="sections-title">
  <p class="eyebrow">chapter 03</p>
  <h2 id="sections-title">the good stuff</h2>

  <div class="grid">
    {
      sections.map((s) => {
        const [top, , dark] = tones[s.tone];
        const id = s.href.slice(1);
        return (
          <article id={id} class="card" style={`--tone:${top};--tone-dark:${dark}`} aria-labelledby={`${id}-title`}>
            <header class="card__bar">
              <span class="card__key" aria-hidden="true">
                {s.key}
              </span>
              <span class="card__file" aria-hidden="true">
                {id}.txt
              </span>
              <span class="card__dots" aria-hidden="true">
                <i />
                <i />
                <i />
              </span>
            </header>
            <div class="card__body">
              <h3 id={`${id}-title`}>{s.label}</h3>
              <p>{notes[id]}</p>
              <p class="card__todo">placeholder · waiting for real content</p>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .sections {
    padding: clamp(64px, 9vw, 120px) var(--gutter) clamp(72px, 10vw, 140px);
    border-top: var(--line) solid var(--ink);
    background: var(--paper);
  }

  .eyebrow {
    margin: 0;
    font: 400 11px/1 var(--font-pixel);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h2 {
    margin: 10px 0 0;
    color: var(--lemon);
    font: 400 clamp(44px, 5vw, 84px) / 0.9 var(--font-display);
    -webkit-text-stroke: 0.07em var(--ink);
    paint-order: stroke fill;
    text-shadow:
      0.035em 0.045em 0 var(--ink),
      0.065em 0.08em 0 var(--tomato);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: clamp(18px, 2.4vw, 32px);
    margin-top: clamp(32px, 4vw, 56px);
  }

  .card {
    scroll-margin-top: 96px;
    border: var(--line) solid var(--ink);
    border-radius: 18px;
    background: var(--cream);
    box-shadow: 8px 9px 0 var(--ink);
    overflow: hidden;
  }

  .card__bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-bottom: var(--line) solid var(--ink);
    background: var(--tone);
  }

  .card__key {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 2px solid var(--ink);
    border-radius: 8px;
    background: var(--cream);
    box-shadow: 0 3px 0 var(--ink);
    font: 650 16px/1 var(--font-body);
  }

  .card__file {
    font: 400 11px/1 var(--font-pixel);
    text-transform: uppercase;
  }

  .card__dots {
    display: flex;
    gap: 5px;
    margin-left: auto;
  }

  .card__dots i {
    width: 11px;
    height: 11px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--cream);
  }

  .card__body {
    padding: 18px 20px 20px;
  }

  h3 {
    margin: 0;
    font: 400 32px/1 var(--font-display);
  }

  .card__body p {
    margin: 10px 0 0;
    color: var(--text-soft);
  }

  .card__body .card__todo {
    display: inline-block;
    margin-top: 16px;
    padding: 6px 8px;
    border: 2px dashed var(--ink);
    border-radius: 8px;
    color: var(--ink);
    font: 400 10px/1.2 var(--font-pixel);
    text-transform: uppercase;
  }

  .card:global(.is-arrived) {
    animation: arrive 0.9s var(--spring);
  }

  @keyframes arrive {
    0% {
      transform: translateY(18px) rotate(-2deg);
      box-shadow: 2px 2px 0 var(--ink);
    }
    45% {
      transform: translateY(-6px) rotate(1deg);
    }
  }
</style>
