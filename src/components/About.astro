---
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import { about, education } from '../data/profile';
import { site } from '../data/site';
import drawing from '../assets/collage/illustration.png';

const tilts = [-3, 2, -1, 3, -2, 1, -3];
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="section__inner about">
    <div class="about__text">
      <SectionHead eyebrow="about.txt" title="about me" id="about-title" />
      {about.paragraphs.map((p) => <p class="about__p">{p}</p>)}
      <p class="about__label">things I get excited about</p>
      <ul class="interests">
        {about.interests.map((item, i) => <li style={`--r:${tilts[i % tilts.length]}deg`}>{item}</li>)}
      </ul>
    </div>

    <aside class="id" aria-labelledby="id-title">
      <span class="id__clip" aria-hidden="true"></span>
      <div class="id__bar">
        <span id="id-title">student id</span>
        <span class="id__chip" aria-hidden="true"></span>
      </div>
      <div class="id__body">
        <div class="id__photo">
          <Image src={drawing} alt="" width={160} height={200} />
        </div>
        <dl class="id__facts">
          <div>
            <dt>name</dt>
            <dd>{site.fullName}</dd>
          </div>
          <div>
            <dt>university</dt>
            <dd>{education.school}</dd>
          </div>
          <div>
            <dt>degree</dt>
            <dd>{education.degree}</dd>
          </div>
          <div>
            <dt>focus</dt>
            <dd>{education.focus}</dd>
          </div>
          <div class="id__pair">
            <div>
              <dt>expected grad</dt>
              <dd>{education.graduation}</dd>
            </div>
            <div>
              <dt>cgpa</dt>
              <dd>{education.cgpa}</dd>
            </div>
          </div>
        </dl>
      </div>
      <div class="id__barcode" aria-hidden="true"></div>
    </aside>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
  }

  .about__p {
    max-width: 50ch;
    margin: 22px 0 0;
    font-size: clamp(18px, 1.5vw, 22px);
    line-height: 1.5;
  }

  .about__p + .about__p {
    margin-top: 14px;
    color: var(--text-soft);
  }

  .about__label {
    margin: 30px 0 0;
    font: 400 24px/1 var(--font-hand);
  }

  .interests {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .interests li {
    padding: 8px 12px 7px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--cream);
    box-shadow: 2px 3px 0 var(--ink);
    font-size: 15px;
    font-weight: 600;
    rotate: var(--r);
  }

  /* ── Student ID ─────────────────────── */
  .id {
    position: relative;
    justify-self: center;
    width: min(100%, 420px);
    border: var(--line) solid var(--ink);
    border-radius: 20px;
    background: var(--cream);
    box-shadow: 10px 12px 0 var(--ink);
    rotate: 2.5deg;
  }

  .id__clip {
    position: absolute;
    top: -22px;
    left: 50%;
    width: 64px;
    height: 34px;
    border: var(--line) solid var(--ink);
    border-radius: 10px;
    background: var(--lilac);
    translate: -50% 0;
  }

  .id__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 18px 12px;
    border-bottom: var(--line) solid var(--ink);
    border-radius: 17px 17px 0 0;
    background: var(--tomato);
    font: 400 12px/1 var(--font-pixel);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .id__chip {
    width: 34px;
    height: 24px;
    border: 2px solid var(--ink);
    border-radius: 6px;
    background: linear-gradient(90deg, transparent 45%, var(--ink) 45% 55%, transparent 55%), var(--lemon);
  }

  .id__body {
    display: grid;
    grid-template-columns: 112px 1fr;
    gap: 16px;
    padding: 18px;
  }

  .id__photo {
    align-self: start;
    overflow: hidden;
    border: var(--line) solid var(--ink);
    border-radius: 10px;
    background: var(--blue);
    aspect-ratio: 4 / 5;
  }

  .id__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .id__facts {
    display: grid;
    gap: 9px;
    margin: 0;
  }

  .id__pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  dt {
    font: 400 9px/1 var(--font-pixel);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  dd {
    margin: 3px 0 0;
    font-size: 15px;
    font-weight: 650;
    line-height: 1.25;
  }

  .id__barcode {
    height: 34px;
    margin: 0 18px 18px;
    background: repeating-linear-gradient(
      90deg,
      var(--ink) 0 3px,
      transparent 3px 5px,
      var(--ink) 5px 6px,
      transparent 6px 9px,
      var(--ink) 9px 13px,
      transparent 13px 15px
    );
    opacity: 0.85;
  }

  @media (max-width: 859px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }

    .id {
      margin-top: 24px;
      rotate: 1.5deg;
    }
  }

  @media (max-width: 420px) {
    .id__body {
      grid-template-columns: 88px 1fr;
    }
  }
</style>
