---
// The little garden growing out of the missing "G" key.
// Drawn upright in its own space: (0, 0) is the middle of the hole, 1 unit ≈ 1% of a key.

interface Props {
  id: string; // keeps <defs> ids unique when the garden appears twice
  can: [x: number, y: number, flip: boolean]; // where the watering can stands
  bubble: [x: number, y: number]; // where the "hello" speech bubble appears
}
const { id, can, bubble } = Astro.props;

// Hidden until someone says hello.
const blossoms: [number, number, number][] = [
  [-66, -180, 1.1],
  [58, -232, 1],
  [2, -254, 1.15],
  [50, -120, 0.9],
  [-42, -152, 0.85],
  [33, -206, 0.9],
  [-70, -8, 1],
  [62, 8, 0.9],
  [-14, -40, 0.8],
];
const extraLeaves: [number, number, number, string][] = [
  [-30, -232, -120, '#79c95a'],
  [70, -182, 10, '#3fae5a'],
  [-80, -152, 170, '#2e8c48'],
  [20, -120, -60, '#79c95a'],
];
const confetti = Array.from({ length: 16 }, (_, i) => {
  const a = (i / 16) * Math.PI * 2;
  const r = 70 + ((i * 37) % 60);
  return {
    dx: Math.round(Math.cos(a) * r),
    dy: Math.round(Math.sin(a) * r * 0.7 - 70),
    rot: ((i * 83) % 540) - 270,
    delay: (i % 5) * 0.03,
    color: ['#ff8fc0', '#ffe14f', '#fffaf0', '#7fe0b0', '#ff6a3d'][i % 5],
    shape: i % 3,
  };
});

const leaves: [number, number, number, number, string][] = [
  [-66, -178, -140, 1, '#3fae5a'],
  [-66, -178, -200, 0.9, '#2e8c48'],
  [-42, -150, -115, 0.85, '#79c95a'],
  [-24, -134, 160, 0.8, '#3fae5a'],
  [58, -230, -40, 1, '#79c95a'],
  [58, -230, 20, 0.9, '#3fae5a'],
  [33, -204, -85, 0.85, '#2e8c48'],
  [2, -250, -90, 1, '#3fae5a'],
  [2, -250, -135, 0.8, '#79c95a'],
  [2, -250, -45, 0.8, '#2e8c48'],
  [50, -118, -20, 0.9, '#3fae5a'],
  [50, -118, 40, 0.8, '#79c95a'],
  [-5, -98, 175, 0.75, '#2e8c48'],
  [2, -62, 15, 0.7, '#3fae5a'],
];

const ground: [number, number, string][] = [
  [-172, 1.5, '#2a7d44'],
  [-146, 1.7, '#3fae5a'],
  [-118, 1.3, '#56b85a'],
  [-62, 1.35, '#2e8c48'],
  [-36, 1.7, '#3fae5a'],
  [-8, 1.45, '#2a7d44'],
];

const daisies: [number, number, number][] = [
  [-26, -18, 1],
  [22, -26, 0.9],
  [4, 4, 1.05],
  [-52, 2, 0.8],
];

const dots = [
  [30, -42],
  [39, -34],
  [26, -31],
  [45, -45],
  [36, -51],
];

const pollen = [
  [-84, -120, 0],
  [74, -152, 0.8],
  [-42, -214, 1.6],
  [92, -64, 2.2],
  [-98, -40, 1.1],
  [22, -284, 2.9],
];
---

<g class="garden">
  <defs>
    <path id={`${id}-leaf`} d="M0 0 C8 -11 27 -11 36 0 C27 11 8 11 0 0 Z"></path>
    <path id={`${id}-petal`} d="M0 -2 C3 -6 3 -11 0 -13 C-3 -11 -3 -6 0 -2 Z" fill="#fff"></path>
    <g id={`${id}-blossom`}>
      {[0, 72, 144, 216, 288].map((a) => <circle cx="0" cy="-5.5" r="5" fill="#ff8fc0" transform={`rotate(${a})`} />)}
      <circle r="3.6" fill="#ffe14f" />
    </g>
  </defs>

  <ellipse cx="0" cy="2" rx="44" ry="17" fill="#7a5038"></ellipse>
  <ellipse cx="-6" cy="-1" rx="26" ry="8" fill="#8f6243"></ellipse>

  <g class="shovel" transform="translate(-40 -22) rotate(-12)">
    <rect x="-3.5" y="-112" width="7" height="84" rx="3.5" fill="#c98b4f"></rect>
    <path d="M-13 -122 H13 Q16 -122 16 -118 V-110 H-16 V-118 Q-16 -122 -13 -122 Z" fill="#a86f3a"></path>
    <path d="M-15 -34 H15 V-12 Q15 8 0 18 Q-15 8 -15 -12 Z" fill="#33408f"></path>
    <path d="M-15 -34 H0 V18 Q-15 8 -15 -12 Z" fill="#4a5aa8"></path>
    <rect x="-6" y="-38" width="12" height="8" rx="2" fill="#27336f"></rect>
  </g>

  <g class="grow">
  <g class="sapling">
    <g fill="none" stroke="#7d4f33" stroke-linecap="round">
      <path d="M0 0 C-6 -50 10 -90 -2 -140 C-10 -175 6 -210 2 -250" stroke-width="7"></path>
      <path d="M-3 -120 C-25 -135 -45 -150 -66 -178" stroke-width="4.5"></path>
      <path d="M1 -176 C20 -190 40 -205 58 -230" stroke-width="4"></path>
      <path d="M4 -80 C22 -92 36 -100 50 -118" stroke-width="3.5"></path>
    </g>
    {
      leaves.map(([x, y, a, s, c]) => (
        <use href={`#${id}-leaf`} fill={c} transform={`translate(${x} ${y}) rotate(${a}) scale(${s})`} />
      ))
    }
    <g class="bloom">
      {
        extraLeaves.map(([x, y, a, c], i) => (
          <g transform={`translate(${x} ${y}) rotate(${a})`}>
            <use class="pop" href={`#${id}-leaf`} fill={c} style={`--i:${i}`} />
          </g>
        ))
      }
      {
        blossoms.slice(0, 6).map(([x, y, s], i) => (
          <g transform={`translate(${x} ${y}) scale(${s})`}>
            <use class="pop" href={`#${id}-blossom`} style={`--i:${i + 4}`} />
          </g>
        ))
      }
    </g>
  </g>
  </g>

  {ground.map(([a, s, c]) => <use href={`#${id}-leaf`} fill={c} transform={`translate(0 -2) rotate(${a}) scale(${s})`} />)}

  <g class="tulips">
    <path d="M-46 -2 Q-48 -20 -46 -34 M-60 2 Q-60 -12 -58 -24" fill="none" stroke="#2e8c48" stroke-width="2.5"></path>
    <path d="M-52 -34 Q-53 -46 -49 -48 L-46 -43 L-43 -48 Q-39 -46 -40 -34 Z" fill="#e4483f"></path>
    <path d="M-64 -24 Q-65 -35 -61 -37 L-58 -32 L-55 -37 Q-51 -35 -52 -24 Z" fill="#f0643f"></path>
  </g>

  <g class="bush">
    <circle cx="48" cy="-6" r="17" fill="#2f6f55"></circle>
    {[[42, -14], [52, -12], [46, -2], [56, -3], [38, -5], [49, -19]].map(([x, y]) => <circle cx={x} cy={y} r="2" fill="#86d1a8" />)}
  </g>

  {dots.map(([x, y]) => <circle cx={x} cy={y} r="3.3" fill="#f7c948" />)}

  {
    daisies.map(([x, y, s]) => (
      <g transform={`translate(${x} ${y}) scale(${s})`}>
        {[0, 45, 90, 135, 180, 225, 270, 315].map((a) => <use href={`#${id}-petal`} transform={`rotate(${a})`} />)}
        <circle r="3.8" fill="#ffc83d" />
      </g>
    ))
  }

  <g class="bloom">
    {
      blossoms.slice(6).map(([x, y, s], i) => (
        <g transform={`translate(${x} ${y}) scale(${s})`}>
          <use class="pop" href={`#${id}-blossom`} style={`--i:${i + 10}`} />
        </g>
      ))
    }
  </g>

  {pollen.map(([x, y, d]) => <circle class="pollen" cx={x} cy={y} r="2.4" fill="#e5a53c" style={`animation-delay:-${d}s`} />)}

  <g class="confetti" transform="translate(0 -190)" aria-hidden="true">
    {
      confetti.map((c) =>
        c.shape === 0 ? (
          <circle r="4.5" fill={c.color} style={`--dx:${c.dx}px;--dy:${c.dy}px;--r:${c.rot}deg;--d:${c.delay}s`} />
        ) : c.shape === 1 ? (
          <rect x="-3" y="-6" width="6" height="12" rx="2" fill={c.color} style={`--dx:${c.dx}px;--dy:${c.dy}px;--r:${c.rot}deg;--d:${c.delay}s`} />
        ) : (
          <use href={`#${id}-petal`} fill={c.color} style={`--dx:${c.dx}px;--dy:${c.dy}px;--r:${c.rot}deg;--d:${c.delay}s`} />
        ),
      )
    }
  </g>

  <g class="butterfly" opacity="0" aria-hidden="true">
    <animateMotion
      data-fly
      dur="4.4s"
      begin="indefinite"
      fill="freeze"
      path="M0 -150 C40 -230 130 -200 110 -280 S-20 -330 -70 -370 S-230 -400 -360 -520"></animateMotion>
    <animate data-fly attributeName="opacity" dur="4.4s" begin="indefinite" fill="freeze" values="0;1;1;0" keyTimes="0;0.08;0.85;1"></animate>
    <g class="butterfly__wings" stroke="#1b1526" stroke-width="1.6" stroke-linejoin="round">
      <path d="M0 0 C-14 -18 -28 -9 -19 4 C-13 12 -4 8 0 2 Z" fill="#ff8fc0"></path>
      <path d="M0 0 C14 -18 28 -9 19 4 C13 12 4 8 0 2 Z" fill="#ff8fc0"></path>
      <path d="M0 3 C-10 7 -14 17 -6 19 C-2 19 0 13 0 5 Z" fill="#ffe14f"></path>
      <path d="M0 3 C10 7 14 17 6 19 C2 19 0 13 0 5 Z" fill="#ffe14f"></path>
    </g>
    <rect x="-1.6" y="-7" width="3.2" height="24" rx="1.6" fill="#1b1526"></rect>
  </g>

  <g class="bubble" transform={`translate(${bubble[0]} ${bubble[1]})`} aria-hidden="true">
    <g class="bubble__body">
      <path
        d="M18 0 H202 A18 18 0 0 1 220 18 V42 A18 18 0 0 1 202 60 H52 L28 84 L32 60 H18 A18 18 0 0 1 0 42 V18 A18 18 0 0 1 18 0 Z"
        fill="#fff8ec"
        stroke="#1b1526"
        stroke-width="3"
        stroke-linejoin="round"></path>
      <text class="bubble__text" x="110" y="31" dy="0.36em" data-bubble-text>hello to you too!</text>
    </g>
  </g>

  <g class="can" transform={`translate(${can[0]} ${can[1]})${can[2] ? ' scale(-1 1)' : ''}`}>
    <g class="can__drops" aria-hidden="true">
      {[0, 1, 2, 3].map((i) => <path d="M0 0 C3 5 3 8 0 9 C-3 8 -3 5 0 0 Z" fill="#8fd8ff" style={`--i:${i}`} />)}
    </g>
    <g class="can__body">
      <path d="M-31 -44 C-60 -46 -60 -6 -29 -10" fill="none" stroke="#c9642a" stroke-width="7" stroke-linecap="round"></path>
      <path d="M26 -30 L70 -74 L77 -67 L33 -20 Z" fill="#e57f31"></path>
      <ellipse cx="75" cy="-72" rx="10" ry="5.5" transform="rotate(-45 75 -72)" fill="#c9642a"></ellipse>
      <path d="M-30 -52 L30 -52 L27 0 Q0 8 -27 0 Z" fill="#ef8a3a"></path>
      <path d="M2 -52 L30 -52 L27 0 Q14 5 2 6 Z" fill="#d86f27"></path>
      <ellipse cx="0" cy="-52" rx="30" ry="8" fill="#f9a45a"></ellipse>
      <ellipse cx="0" cy="-52" rx="22" ry="5" fill="#b85a1d"></ellipse>
    </g>
  </g>
</g>

<style>
  .sapling {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: sway 5s ease-in-out infinite alternate;
  }

  @keyframes sway {
    from {
      transform: rotate(-1.8deg);
    }
    to {
      transform: rotate(2deg);
    }
  }

  .pollen {
    animation: drift 4s ease-in-out infinite alternate;
  }

  @keyframes drift {
    to {
      transform: translate(6px, -10px);
    }
  }

  .can {
    cursor: pointer;
  }

  .can__body {
    transform-box: fill-box;
    transform-origin: 20% 100%;
    transition: transform 0.6s var(--spring);
  }

  .can:hover .can__body,
  .can.is-pouring .can__body {
    transform: rotate(-28deg);
  }

  .can__drops path {
    opacity: 0;
    transform: translate(46px, -40px);
  }

  .can:hover .can__drops path,
  .can.is-pouring .can__drops path {
    animation: pour 0.9s ease-in infinite;
    animation-delay: calc(var(--i) * 0.22s);
  }

  @keyframes pour {
    0% {
      opacity: 0;
      transform: translate(46px, -40px);
    }
    20% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(96px, 10px);
    }
  }

  /* ── Saying hello ───────────────────── */
  .grow {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    transition: scale 1.1s var(--spring);
  }

  :global(.has-bloomed) .grow {
    scale: 1.14;
  }

  .pop {
    scale: 0;
    transform-box: fill-box;
    transform-origin: center;
    transition: scale 0.7s var(--spring);
    transition-delay: calc(var(--i) * 70ms);
  }

  :global(.has-bloomed) .pop {
    scale: 1;
  }

  .confetti > * {
    opacity: 0;
  }

  :global(.is-hello) .confetti > * {
    animation: burst 1.5s cubic-bezier(0.2, 0.7, 0.3, 1) var(--d) both;
  }

  @keyframes burst {
    0% {
      opacity: 0;
      transform: translate(0, 0) rotate(0deg) scale(0.2);
    }
    12% {
      opacity: 1;
    }
    55% {
      opacity: 1;
      transform: translate(var(--dx), var(--dy)) rotate(var(--r)) scale(1);
    }
    100% {
      opacity: 0;
      transform: translate(var(--dx), calc(var(--dy) + 110px)) rotate(calc(var(--r) * 1.5)) scale(0.8);
    }
  }

  .butterfly__wings {
    transform-box: fill-box;
    transform-origin: center;
    animation: flap 0.2s ease-in-out infinite alternate;
  }

  @keyframes flap {
    to {
      transform: scaleX(0.3);
    }
  }

  .bubble__body {
    opacity: 0;
    scale: 0.3;
    transform-box: fill-box;
    transform-origin: 15% 100%;
    transition:
      opacity 0.2s ease,
      scale 0.5s var(--spring);
  }

  :global(.is-hello) .bubble__body,
  :global(.is-hint) .bubble__body {
    opacity: 1;
    scale: 1;
  }

  .bubble__text {
    fill: var(--ink);
    font-family: var(--font-hand);
    font-size: 26px;
    text-anchor: middle;
  }

  @media (prefers-reduced-motion: reduce) {
    .sapling,
    .pollen,
    .butterfly__wings {
      animation: none;
    }
  }
</style>
