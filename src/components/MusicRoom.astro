---
import Sleeve from './Sleeve.astro';
import Turntable from './Turntable.astro';
import { CRATE, deckLabel, playlist, roomNote, tintFor } from '../data/music';

const crate = playlist.tracks.slice(0, CRATE);
const tilts = [-2.4, 1.8, -1.2, 2.6, -2, 1.3, -2.8, 2.1, -1.6];
const shifts = [0, 16, -10, 22, -6, 12, -18, 8, -14];

// The browser needs the whole playlist to dig through and to shuffle.
const payload = {
  url: playlist.url,
  name: playlist.name,
  crate: CRATE,
  tracks: playlist.tracks.map((t) => ({ ...t, label: tintFor(t.id).label, paper: tintFor(t.id).paper })),
};
---

<section class="room" data-room data-playlist={JSON.stringify(payload)} aria-labelledby="room-title">
  <div class="room__head">
    <p class="eyebrow">music.room</p>
    <h1 id="room-title">my records</h1>
    <p class="room__note">{roomNote}</p>
  </div>

  <div class="room__body">
    <!-- ── the crate ────────────────────────── -->
    <div class="shelf">
      <h2 class="shelf__title" id="shelf-title">the crate</h2>
      <p class="shelf__hint">
        <span data-crate-count>{playlist.tracks.length}</span> records · pick one up and put it on
      </p>
      <ul class="stack" aria-labelledby="shelf-title">
        {
          crate.map((t, i) => (
            <li class="stack__item" style={`--r:${tilts[i % tilts.length]}deg;--x:${shifts[i % shifts.length]}px`}>
              <button class="pick" type="button" data-pick={i} aria-pressed="false">
                <span class="sr-only">Put on </span>
                <span class="pick__disc" aria-hidden="true" style={`--label:${tintFor(t.id).label}`} />
                <Sleeve track={t} />
                <span class="pick__meta">
                  <span class="pick__title" data-pick-title>{t.title}</span>
                  <span class="pick__artist" data-pick-artist>{t.artist}</span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>
      <button class="key key--sm dig" type="button" data-dig>dig deeper <span aria-hidden="true">⤵</span></button>
    </div>

    <!-- ── the deck ─────────────────────────── -->
    <div class="deck-area">
      <div class="deck-area__table">
        <Turntable />
      </div>

      <p class="deck-area__label">{deckLabel}</p>

      <div class="panel" role="group" aria-label="Turntable controls">
        <button class="panel__btn" type="button" data-prev aria-label="Previous record">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 5v14L8 12zM6 5h2.4v14H6z" /></svg>
        </button>
        <button class="panel__btn panel__btn--main" type="button" data-toggle aria-pressed="false">
          <svg class="panel__play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5 20 12 7 19.5z" /></svg>
          <svg class="panel__stop" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2" /></svg>
          <span class="sr-only" data-toggle-label>Play</span>
        </button>
        <button class="panel__btn" type="button" data-next aria-label="Next record">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5v14l10-7zM15.6 5H18v14h-2.4z" /></svg>
        </button>
        <button class="panel__btn" type="button" data-shuffle aria-label="Shuffle: play anything from the playlist">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M3 7h3.5l3 5M3 17h3.5l3-5M21 7h-4m4 0-2.5-2.5M21 7l-2.5 2.5M21 17h-4m4 0-2.5-2.5M21 17l-2.5 2.5M13.5 7H17M13.5 17H17"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>

        <div class="panel__rpm" role="group" aria-label="Platter speed">
          <button class="rpm" type="button" data-rpm="33" aria-pressed="true">33⅓</button>
          <button class="rpm" type="button" data-rpm="45" aria-pressed="false">45</button>
        </div>
      </div>

      <p class="panel__note">the speed and pitch move the platter — Spotify keeps its own tempo.</p>

      <!-- ── what's on ─────────────────────── -->
      <div class="now" data-now>
        <p class="now__empty" data-now-empty>nothing on the platter yet — pick a record.</p>
        <div class="now__card" data-now-card hidden>
          <p class="now__line">
            <strong data-now-title></strong>
            <span data-now-artist></span>
          </p>
          <p class="now__cue" data-cue hidden>
            <span aria-hidden="true">↓</span> your browser is holding playback — press play in the Spotify bar below.
          </p>
          <div class="now__links">
            <a class="key key--sm" data-now-link href={playlist.url} target="_blank" rel="noopener">
              open in Spotify<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Spotify's own player: it does the actual streaming. -->
      <div class="amp" data-amp>
        <p class="amp__label">
          <span class="amp__dot" aria-hidden="true"></span>
          streaming from
          <a href={playlist.url} target="_blank" rel="noopener">
            Spotify · {playlist.name}<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </p>
        <div class="amp__embed">
          <p class="amp__idle">the player loads when you put a record on</p>
          <div data-embed></div>
        </div>
        <p class="amp__fineprint">
          Full tracks play if you're signed in to Spotify; otherwise you get a 30-second preview.
        </p>
      </div>
    </div>
  </div>

  <!-- the record in transit, between sleeve and platter -->
  <div class="flier" data-flier aria-hidden="true">
    <span class="flier__disc" data-flier-disc></span>
  </div>
</section>

<script>
  import { initMusicRoom } from '../scripts/turntable';
  document.querySelectorAll<HTMLElement>('[data-room]').forEach(initMusicRoom);
</script>

<style>
  .room {
    padding: 104px var(--gutter) clamp(72px, 10vw, 120px);
  }

  .room__head {
    max-width: 1240px;
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0;
    font: 400 11px/1 var(--font-pixel);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h1 {
    margin: 12px 0 0;
    color: var(--lemon);
    font: 400 clamp(46px, 6vw, 92px) / 0.92 var(--font-display);
    -webkit-text-stroke: 0.07em var(--ink);
    paint-order: stroke fill;
    text-shadow:
      0.035em 0.045em 0 var(--ink),
      0.065em 0.08em 0 var(--tomato);
  }

  .room__note {
    max-width: 34ch;
    margin: 14px 0 0;
    font: 400 clamp(22px, 2vw, 28px) / 1.15 var(--font-hand);
    rotate: -1.5deg;
  }

  .room__body {
    display: grid;
    grid-template-columns: minmax(190px, 0.52fr) minmax(0, 1.48fr);
    align-items: start;
    gap: clamp(28px, 5vw, 72px);
    max-width: 1240px;
    margin: clamp(36px, 5vw, 64px) auto 0;
  }

  /* ── crate ───────────────────────────── */
  .shelf__title {
    margin: 0;
    font: 400 clamp(24px, 2.2vw, 32px) / 1 var(--font-display);
  }

  .shelf__hint {
    margin: 6px 0 0;
    color: var(--text-soft);
    font: 400 20px/1.2 var(--font-hand);
  }

  .stack {
    max-width: 268px;
    margin: 26px 0 0;
    padding: 0 0 32px;
    list-style: none;
  }

  .stack__item {
    position: relative;
    z-index: 2;
  }

  .stack__item + .stack__item {
    margin-top: -32%;
  }

  .dig {
    margin-top: 4px;
  }

  .pick {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    rotate: var(--r);
    translate: var(--x) 0;
    transition:
      translate 0.4s var(--ease-out),
      rotate 0.4s var(--ease-out),
      filter 0.3s ease;
    -webkit-tap-highlight-color: transparent;
  }

  @media (hover: hover) {
    .stack:hover .pick {
      filter: saturate(0.85) brightness(0.96);
    }

    .stack__item:hover .pick,
    .pick:focus-visible {
      translate: calc(var(--x) + 10px) -14px;
      rotate: calc(var(--r) * 0.3);
      filter: none;
      z-index: 3;
    }

    .stack__item:hover + .stack__item .pick {
      translate: var(--x) 12px;
    }
  }

  .pick[aria-pressed='true'] {
    translate: calc(var(--x) + 16px) -10px;
    rotate: 0deg;
  }

  .pick:focus-visible {
    outline: 3px dashed var(--purple);
    outline-offset: 6px;
  }

  .pick__disc {
    position: absolute;
    top: 6%;
    right: -6%;
    width: 88%;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle, var(--label) 0 17%, transparent 17%),
      repeating-radial-gradient(circle, #241d3a 0 2px, #171226 2px 4px);
    box-shadow: 2px 3px 8px rgb(27 21 38 / 0.4);
    transition: right 0.45s var(--spring);
  }

  @media (hover: hover) {
    .stack__item:hover .pick__disc {
      right: -14%;
    }
  }

  /* The title only surfaces when you reach for the sleeve, so the pile stays a pile. */
  .pick__meta {
    position: absolute;
    top: calc(100% + 10px);
    left: 2px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    max-width: 100%;
    text-align: left;
    opacity: 0;
    translate: 0 -6px;
    transition:
      opacity 0.25s ease,
      translate 0.25s var(--ease-out);
  }

  .stack__item:hover .pick__meta,
  .pick:focus-visible .pick__meta,
  .pick[aria-pressed='true'] .pick__meta {
    opacity: 1;
    translate: 0 0;
  }

  .pick__title {
    overflow: hidden;
    color: var(--ink);
    font: 400 20px/1.05 var(--font-display);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pick__artist {
    overflow: hidden;
    color: var(--text-soft);
    font: 400 10px/1.3 var(--font-pixel);
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ── deck ────────────────────────────── */
  .deck-area__table {
    position: relative;
    z-index: 1;
    max-width: 700px;
    margin: 0 auto;
  }

  .deck-area__label {
    margin: 4px 0 0;
    font: 400 24px/1 var(--font-hand);
    text-align: center;
  }

  .panel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: max-content;
    max-width: 100%;
    margin: 16px auto 0;
    padding: 14px 18px;
    border-radius: 26px;
    background: linear-gradient(#e7ebe4, #c4ccc1);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.8) inset,
      0 8px 0 #8d998e,
      0 14px 22px -10px rgb(27 21 38 / 0.55);
  }

  .panel__note {
    margin: 14px auto 0;
    color: var(--text-soft);
    font: 400 18px/1.2 var(--font-hand);
    text-align: center;
  }

  .panel__btn {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    padding: 0;
    border: 0;
    border-radius: 14px;
    background: linear-gradient(#fdfdfb, #dfe4dc);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.9) inset,
      0 4px 0 #9aa69b;
    color: #3f4a42;
    cursor: pointer;
    transition:
      translate 0.12s ease,
      box-shadow 0.12s ease;
  }

  .panel__btn svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }

  .panel__btn:hover {
    background: linear-gradient(#fff, #e9eee6);
  }

  .panel__btn:active {
    translate: 0 4px;
    box-shadow: 0 0 0 #9aa69b;
  }

  .panel__btn--main {
    width: 64px;
    height: 64px;
    border-radius: 18px;
    background: linear-gradient(#ff8a63, #ef5f33);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.45) inset,
      0 5px 0 #b8421c;
    color: #fff8ec;
  }

  .panel__btn--main:hover {
    background: linear-gradient(#ff9b78, #ff6a3d);
  }

  .panel__btn--main svg {
    width: 26px;
    height: 26px;
  }

  .panel__stop {
    display: none;
  }

  .panel__btn--main[aria-pressed='true'] .panel__play {
    display: none;
  }

  .panel__btn--main[aria-pressed='true'] .panel__stop {
    display: block;
  }

  .panel__rpm {
    display: flex;
    gap: 4px;
    padding: 4px;
    border-radius: 14px;
    background: #8d998e;
  }

  .rpm {
    min-width: 46px;
    padding: 7px 8px 6px;
    border: 0;
    border-radius: 10px;
    background: #e7ebe4;
    color: #4f5a51;
    font: 400 11px/1 var(--font-pixel);
    cursor: pointer;
  }

  .rpm[aria-pressed='true'] {
    background: var(--lemon);
    color: var(--ink);
  }

  /* ── now playing ─────────────────────── */
  .now {
    max-width: 560px;
    margin: 20px auto 0;
    text-align: center;
  }

  .now__empty {
    margin: 0;
    color: var(--text-soft);
    font: 400 22px/1.2 var(--font-hand);
  }

  .now__card {
    padding: 18px 22px;
    border: var(--line) solid var(--ink);
    border-radius: 18px;
    background: var(--cream);
    box-shadow: 7px 8px 0 var(--ink);
  }

  .now__card[hidden] {
    display: none;
  }

  .now__line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 6px 10px;
    margin: 0;
  }

  .now__line strong {
    font: 400 30px/1 var(--font-display);
    font-weight: 400;
  }

  .now__line span {
    color: var(--text-soft);
    font-size: 16px;
    font-weight: 600;
  }

  .now__cue {
    margin: 12px 0 0;
    padding: 8px 10px;
    border: 2px dashed var(--ink);
    border-radius: 10px;
    font-size: 14px;
    line-height: 1.35;
  }

  .now__cue[hidden] {
    display: none;
  }

  .now__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 14px;
  }

  /* ── the amp: Spotify's player ───────── */
  .amp {
    max-width: 560px;
    margin: 22px auto 0;
    padding: 14px 16px 12px;
    border-radius: 20px;
    background: linear-gradient(#e7ebe4, #cbd3c8);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.8) inset,
      0 7px 0 #8d998e,
      0 14px 22px -12px rgb(27 21 38 / 0.5);
  }

  .amp__label {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0 0 10px;
    color: #4f5a51;
    font: 400 10px/1.3 var(--font-pixel);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .amp__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #1db954;
    box-shadow: 0 0 7px #1db95499;
  }



  .amp__embed {
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 12px;
    background: #191414;
    min-height: 80px;
  }

  .amp__idle {
    margin: 0;
    padding: 0 12px;
    color: #9a93a8;
    font: 400 10px/1.4 var(--font-pixel);
    letter-spacing: 0.04em;
    text-align: center;
    text-transform: uppercase;
  }

  .amp.is-live .amp__idle {
    display: none;
  }

  .amp__dot {
    opacity: 0.35;
  }

  .amp.is-live .amp__dot {
    opacity: 1;
  }

  .amp__embed :global(iframe) {
    display: block;
    width: 100%;
    border: 0;
  }

  .amp__fineprint {
    margin: 10px 2px 0;
    color: #5d6a5f;
    font-size: 12px;
    line-height: 1.4;
  }

  /* ── the record in transit ───────────── */
  .flier {
    position: fixed;
    inset: 0;
    z-index: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .flier.is-flying {
    z-index: 60;
  }

  .flier.is-on {
    visibility: visible;
  }

  .flier__disc {
    position: absolute;
    top: 0;
    left: 0;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background:
      radial-gradient(circle, #120d1e 0 3.6%, var(--label, #b9a6fb) 3.6% 31%, transparent 31%),
      repeating-radial-gradient(circle, #2d2742 0 2px, #171226 2px 4.4px);
    box-shadow: 0 18px 26px -14px rgb(27 21 38 / 0.7);
    transform-origin: 0 0;
    will-change: transform;
  }

  /* ── phones & small tablets ──────────── */
  @media (max-width: 899px) {
    .room {
      padding-top: 88px;
    }

    .room__body {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    /* deck → controls → the records → what's on → the player. */
    .deck-area {
      display: contents;
    }

    .deck-area__table {
      order: 1;
    }

    .deck-area__label {
      order: 2;
    }

    .panel {
      order: 3;
      margin-top: 4px;
    }

    .panel__note {
      order: 4;
      margin-top: 10px;
    }

    .shelf {
      order: 5;
    }

    .now {
      order: 6;
      margin-top: 4px;
    }

    .amp {
      order: 7;
      margin-top: 4px;
    }

    .stack {
      display: flex;
      gap: 14px;
      max-width: none;
      margin-top: 16px;
      padding: 10px 2px 18px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }

    .stack__item {
      flex: 0 0 min(58vw, 240px);
      scroll-snap-align: center;
    }

    .stack__item + .stack__item {
      margin-top: 0;
    }

    .pick {
      rotate: 0deg;
      translate: 0 0;
    }

    .pick[aria-pressed='true'] {
      translate: 0 -8px;
    }

    .pick__disc {
      right: -5%;
      width: 76%;
    }

    .pick__meta {
      position: static;
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pick,
    .pick__disc {
      transition: none;
    }
  }
</style>
