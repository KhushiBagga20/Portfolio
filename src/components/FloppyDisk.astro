---
// A chunky 3.5" floppy with a handwritten label. Decorative: the text next to it carries the meaning.
import type { DiskTone } from '../data/projects';

interface Props {
  tone: DiskTone;
  scribble: string;
  class?: string;
}

const bodies: Record<DiskTone, [string, string]> = {
  tomato: ['#ff6a3d', '#e2522a'],
  pink: ['#ff8fc0', '#ea6fa6'],
  lilac: ['#b9a3fb', '#9b83ef'],
  lemon: ['#ffd84a', '#f0bd1c'],
  sky: ['#86b4f7', '#6a98e6'],
  mint: ['#63d3a0', '#43b784'],
};

const { tone, scribble, class: className } = Astro.props;
const [body, shade] = bodies[tone];
---

<svg class:list={['disk', className]} viewBox="0 0 200 200" aria-hidden="true">
  <path
    d="M16 3 H172 L197 28 V184 Q197 197 184 197 H16 Q3 197 3 184 V16 Q3 3 16 3 Z"
    fill={body}
    stroke="#1b1526"
    stroke-width="5"
    stroke-linejoin="round"></path>
  <path d="M10 186 H186 Q192 186 192 180 V36" fill="none" stroke={shade} stroke-width="7" stroke-linecap="round"></path>
  <path d="M18 12 H164 M12 18 V170" fill="none" stroke="#fff" stroke-opacity="0.4" stroke-width="4" stroke-linecap="round"></path>

  <rect x="72" y="12" width="46" height="48" rx="4" fill="#3a2f55"></rect>
  <g class="disk__shutter">
    <rect x="50" y="3" width="104" height="66" rx="4" fill="#e3e7f1" stroke="#1b1526" stroke-width="4.5"></rect>
    <rect x="112" y="14" width="24" height="44" rx="3" fill="#1b1526"></rect>
    <path d="M60 15 V57" stroke="#b9bfce" stroke-width="3" stroke-linecap="round"></path>
  </g>

  <rect x="22" y="88" width="156" height="98" rx="8" fill="#fffaf0" stroke="#1b1526" stroke-width="4.5"></rect>
  <path d="M34 128 H166 M34 150 H166 M34 172 H166" stroke="#c9d6ff" stroke-width="2"></path>
  <text class="disk__brand" x="100" y="106">HD · 1.44 MB</text>
  <text
    class="disk__scribble"
    x="100"
    y="148"
    transform="rotate(-4 100 148)"
    textLength={scribble.length > 9 ? 138 : undefined}
    lengthAdjust="spacingAndGlyphs">{scribble}</text
  >

  <rect x="10" y="170" width="10" height="13" rx="2" fill="#1b1526"></rect>
</svg>

<style>
  .disk {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .disk__shutter {
    transition: transform 0.55s var(--spring);
  }

  .disk__brand {
    fill: #1b1526;
    font-family: var(--font-pixel);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-anchor: middle;
  }

  .disk__scribble {
    fill: #1b1526;
    font-family: var(--font-hand);
    font-size: 36px;
    text-anchor: middle;
  }
</style>
