---
// Speaker keycap in the nav. Also gives every keycap-style button on the site its click.
---

<button class="key key--nav sound" type="button" aria-pressed="true" data-sound-toggle>
  <svg class="sound__icon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M3.5 9.2h3.8L12 5.3v13.4l-4.7-3.9H3.5z" fill="currentColor" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
    <path class="sound__waves" d="M15.4 9.3a4 4 0 0 1 0 5.4M18 6.6a7.6 7.6 0 0 1 0 10.8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
    <path class="sound__off" d="M15.5 9.5l5 5M20.5 9.5l-5 5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
  </svg>
  <span class="sr-only">Keyboard sounds</span>
</button>

<script>
  import { isSoundOn, keyDown, keyUp, onSoundChange, setSound, warmUp } from '../scripts/sound';

  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-sound-toggle]');
  const sync = (on: boolean) =>
    buttons.forEach((b) => {
      b.setAttribute('aria-pressed', String(on));
      b.title = on ? 'Sounds on' : 'Sounds off';
    });
  sync(isSoundOn());
  onSoundChange(sync);

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      setSound(!isSoundOn());
      if (isSoundOn()) keyDown(0.9);
    }),
  );

  const onKeycap = (e: Event) => (e.target as Element | null)?.closest?.('.key');
  document.addEventListener('pointerdown', (e) => (warmUp(), onKeycap(e) && keyDown(0.9)), { passive: true });
  document.addEventListener('pointerup', (e) => onKeycap(e) && keyUp(), { passive: true });
</script>

<style>
  .sound {
    --key-depth: 4px;
    width: 44px;
    min-height: 40px;
    padding: 0;
  }

  .sound__icon {
    width: 22px;
    height: 22px;
  }

  .sound[aria-pressed='true'] .sound__off,
  .sound[aria-pressed='false'] .sound__waves {
    display: none;
  }

  .sound[aria-pressed='false'] {
    --key-face: var(--paper-deep);
  }
</style>
