---
// One record sleeve. The cover comes straight from Spotify's CDN; if a track somehow
// has no artwork, the sleeve is typeset from the title and artist instead.
//
// Everything the browser needs to repaint this sleeve for a different track carries a
// data- hook, so digging through the crate doesn't rebuild any markup.
import { tintFor, type Track } from '../data/music';

interface Props {
  track: Track;
}

const { track } = Astro.props;
const tint = tintFor(track.id);
---

<div class="sleeve" data-sleeve style={`--paper:${tint.paper};--label:${tint.label}`}>
  <img
    class="sleeve__art"
    data-cover
    src={track.cover ?? ''}
    alt=""
    width="300"
    height="300"
    loading="lazy"
    decoding="async"
    hidden={!track.cover}
  />
  <div class="sleeve__blank" data-blank aria-hidden="true" hidden={Boolean(track.cover)}>
    <span class="sleeve__ring"></span>
    <p class="sleeve__artist" data-blank-artist>{track.artist}</p>
    <p class="sleeve__title" data-blank-title>{track.title}</p>
    <span class="sleeve__bar"></span>
  </div>
  <span class="sleeve__spine" aria-hidden="true"></span>
  <span class="sleeve__gloss" aria-hidden="true"></span>
</div>

<style>
  .sleeve {
    container-type: inline-size;
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 3px;
    background: var(--paper);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.5) inset,
      0 10px 18px -8px rgb(27 21 38 / 0.5),
      0 2px 0 rgb(27 21 38 / 0.25);
  }

  .sleeve__art {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sleeve__art[hidden] {
    display: none;
  }

  /* Only used when a track has no artwork. */
  .sleeve__blank {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    padding: 9% 9% 8%;
    background:
      radial-gradient(60% 50% at 70% 18%, rgb(255 255 255 / 0.55), transparent 70%),
      var(--paper);
    color: #2a2440;
  }

  .sleeve__blank[hidden] {
    display: none;
  }

  .sleeve__ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 72%;
    aspect-ratio: 1;
    border: 1px solid currentColor;
    border-radius: 50%;
    opacity: 0.14;
    translate: -50% -50%;
  }

  .sleeve__artist {
    margin: 0;
    font: 400 clamp(8px, 1.1cqw, 11px) / 1.2 var(--font-pixel);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .sleeve__title {
    margin: 2% 0 0;
    font: 400 clamp(17px, 2.6cqw, 34px) / 0.95 var(--font-display);
    overflow-wrap: anywhere;
  }

  .sleeve__bar {
    width: 38%;
    height: 4px;
    margin-top: 6%;
    border-radius: 2px;
    background: var(--label);
  }

  .sleeve__spine {
    position: absolute;
    inset: 0 auto 0 0;
    width: 4.5%;
    background: linear-gradient(90deg, rgb(27 21 38 / 0.3), rgb(27 21 38 / 0.04));
  }

  .sleeve__gloss {
    position: absolute;
    inset: 0;
    background: linear-gradient(118deg, transparent 42%, rgb(255 255 255 / 0.22) 50%, transparent 58%);
  }
</style>
