---
// One record sleeve. Uses the cover image when there is one, and otherwise
// typesets the sleeve by hand — honest, and it still looks like a real sleeve.
import { Image } from 'astro:assets';
import type { Record } from '../data/music';

interface Props {
  record: Record;
  sizes?: string;
}

const { record: r, sizes = '(max-width: 899px) 60vw, 26vw' } = Astro.props;
const title = r.title || r.artist;
---

<div class="sleeve" style={`--paper:${r.sleeve.paper};--ink:${r.sleeve.ink};--label:${r.sleeve.label}`}>
  {
    r.cover ? (
      <Image class="sleeve__art" src={r.cover} alt={`${title} — ${r.artist}`} widths={[240, 420, 640]} sizes={sizes} />
    ) : (
      <div class="sleeve__art sleeve__art--blank" aria-hidden="true">
        <span class="sleeve__ring" />
        <p class="sleeve__artist">{r.artist}</p>
        {r.title ? <p class="sleeve__title">{r.title}</p> : <p class="sleeve__title sleeve__title--todo">untitled</p>}
        <span class="sleeve__bar" />
      </div>
    )
  }
  <span class="sleeve__spine" aria-hidden="true"></span>
  <span class="sleeve__gloss" aria-hidden="true"></span>
</div>

<style>
  .sleeve {
    container-type: inline-size;
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 3px;
    background: var(--paper);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.5) inset,
      0 10px 18px -8px rgb(27 21 38 / 0.5),
      0 2px 0 rgb(27 21 38 / 0.25);
  }

  .sleeve__art {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Typeset sleeve, used until a cover image exists. */
  .sleeve__art--blank {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    padding: 9% 9% 8%;
    background:
      radial-gradient(60% 50% at 70% 18%, rgb(255 255 255 / 0.55), transparent 70%),
      var(--paper);
    color: var(--ink);
  }

  .sleeve__ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 72%;
    aspect-ratio: 1;
    border: 1px solid currentColor;
    border-radius: 50%;
    opacity: 0.14;
    translate: -50% -50%;
  }

  .sleeve__ring::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 30%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--label);
    opacity: 0.5;
    translate: -50% -50%;
  }

  .sleeve__artist {
    margin: 0;
    font: 400 clamp(8px, 1.1cqw, 11px) / 1.2 var(--font-pixel);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .sleeve__title {
    margin: 2% 0 0;
    font: 400 clamp(17px, 2.6cqw, 34px) / 0.95 var(--font-display);
    overflow-wrap: anywhere;
  }

  .sleeve__title--todo {
    opacity: 0.45;
  }

  .sleeve__bar {
    width: 38%;
    height: 4px;
    margin-top: 6%;
    border-radius: 2px;
    background: var(--label);
  }

  /* The sleeve's folded edge and a sheen across the plastic. */
  .sleeve__spine {
    position: absolute;
    inset: 0 auto 0 0;
    width: 4.5%;
    background: linear-gradient(90deg, rgb(27 21 38 / 0.3), rgb(27 21 38 / 0.04));
  }

  .sleeve__gloss {
    position: absolute;
    inset: 0;
    background: linear-gradient(118deg, transparent 42%, rgb(255 255 255 / 0.22) 50%, transparent 58%);
  }
</style>
