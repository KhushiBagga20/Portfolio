---
// The only way missing details show up on the site: an honest, styled "coming soon".
interface Props {
  text?: string;
}

const { text = 'details coming soon' } = Astro.props;
---

<span class="soon"><span aria-hidden="true">✎</span> {text}</span>

<style>
  .soon {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px 5px;
    border: 2px dashed var(--ink);
    border-radius: 8px;
    background: rgb(255 255 255 / 0.35);
    color: var(--ink);
    font: 400 10px/1.2 var(--font-pixel);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
