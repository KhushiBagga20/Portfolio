---
import SectionHead from './SectionHead.astro';
import { communities } from '../data/profile';
---

<section id="experience" class="section section--deep" aria-labelledby="experience-title">
  <div class="section__inner">
    <SectionHead eyebrow="communities & roles" title="beyond projects" id="experience-title" fill="cream" />

    <ul class="passes">
      {
        communities.map((c, i) => (
          <li class="pass" style={`--tone:var(--${c.tone});--r:${i % 2 ? 2 : -2}deg`}>
            <div class="pass__top">
              <span class="pass__hole" aria-hidden="true" />
              <span class="pass__org">{c.org}</span>
            </div>
            <div class="pass__body">
              <h3 class="pass__name">{c.name}</h3>
              <p class="pass__role">{c.role}</p>
              <p class="pass__line">{c.line}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .passes {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(24px, 4vw, 48px);
    margin: 52px 0 0;
    padding: 0;
    list-style: none;
  }

  .pass {
    width: min(100%, 340px);
    border: var(--line) solid var(--ink);
    border-radius: 20px;
    background: var(--cream);
    box-shadow: 8px 9px 0 var(--ink);
    rotate: var(--r);
  }

  .pass__top {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 14px 16px 12px;
    border-bottom: var(--line) solid var(--ink);
    border-radius: 17px 17px 0 0;
    background: var(--tone);
  }

  .pass__hole {
    width: 46px;
    height: 12px;
    border: var(--line) solid var(--ink);
    border-radius: 999px;
    background: var(--paper-deep);
  }

  .pass__org {
    font: 400 10px/1.3 var(--font-pixel);
    letter-spacing: 0.05em;
    text-align: center;
    text-transform: uppercase;
  }

  .pass__body {
    padding: 20px 22px 24px;
    text-align: center;
  }

  .pass__name {
    margin: 0;
    font: 400 40px/1 var(--font-display);
  }

  .pass__role {
    display: inline-block;
    margin: 12px 0 0;
    padding: 6px 12px 5px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--paper);
    font-size: 15px;
    font-weight: 700;
  }

  .pass__line {
    margin: 14px 0 0;
    color: var(--text-soft);
  }
</style>
