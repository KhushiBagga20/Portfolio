---
import ComingSoon from './ComingSoon.astro';
import SectionHead from './SectionHead.astro';
import { site } from '../data/site';

// Only links you've actually filled in (src/data/site.ts) show up.
const { email } = site.links;
const links = [
  { label: 'email me', href: email ? `mailto:${email}` : '', external: false, tone: 'key--tomato' },
  { label: 'LinkedIn', href: site.links.linkedin, external: true, tone: '' },
  { label: 'GitHub', href: site.links.github, external: true, tone: '' },
  { label: 'résumé (PDF)', href: site.links.resume, external: true, tone: 'key--yellow' },
].filter((l) => l.href);
---

<section id="contact" class="section section--deep" aria-labelledby="contact-title">
  <div class="section__inner contact">
    <SectionHead eyebrow="contact.eml" title="say hi" id="contact-title" />

    <div class="mail">
      <div class="mail__bar">
        <span>new message</span>
        <span class="mail__dots" aria-hidden="true"><i></i><i></i><i></i></span>
      </div>
      <div class="mail__body">
        <p class="mail__to">
          <span>to:</span>
          {site.fullName}
          {
            email && (
              <span class="mail__address">
                &lt;{email}&gt;
                <button class="mail__copy" type="button" data-copy={email}>
                  copy
                </button>
              </span>
            )
          }
        </p>
        <p class="mail__msg">
          Building something unusual, running a hackathon, or want to talk about AI and design? I'd love to hear from you.
        </p>
        {
          links.length ? (
            <div class="mail__links">
              {links.map((l) => (
                <a
                  class:list={['key', l.tone]}
                  href={l.href}
                  target={l.external ? '_blank' : undefined}
                  rel={l.external ? 'noopener' : undefined}
                >
                  {l.label}
                  {l.external && <span class="sr-only"> (opens in a new tab)</span>}
                </a>
              ))}
            </div>
          ) : (
            <ComingSoon text="contact links coming soon" />
          )
        }
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) =>
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy!);
        button.textContent = 'copied!';
      } catch {
        button.textContent = 'select it ↑';
      }
      window.setTimeout(() => (button.textContent = 'copy'), 1800);
    }),
  );
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(32px, 6vw, 88px);
  }

  .mail {
    border: var(--line) solid var(--ink);
    border-radius: 18px;
    background: var(--cream);
    box-shadow: 10px 12px 0 var(--ink);
    rotate: -1.5deg;
  }

  .mail__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: var(--line) solid var(--ink);
    border-radius: 15px 15px 0 0;
    background: var(--lemon);
    font: 400 11px/1 var(--font-pixel);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .mail__dots {
    display: flex;
    gap: 5px;
  }

  .mail__dots i {
    width: 11px;
    height: 11px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--cream);
  }

  .mail__body {
    padding: clamp(20px, 3vw, 32px);
  }

  .mail__to {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    margin: 0;
    padding-bottom: 12px;
    border-bottom: 2px dashed rgb(27 21 38 / 0.25);
    font-weight: 650;
  }

  .mail__to > span:first-child {
    color: var(--ink-soft);
    font: 400 11px/1 var(--font-pixel);
    text-transform: uppercase;
  }

  .mail__address {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    color: var(--text-soft);
    font-weight: 500;
    word-break: break-all;
  }

  .mail__copy {
    padding: 3px 8px 2px;
    border: 2px solid var(--ink);
    border-radius: 6px;
    background: var(--cream);
    box-shadow: 0 2px 0 var(--ink);
    color: var(--ink);
    font: 400 10px/1.2 var(--font-pixel);
    text-transform: uppercase;
    cursor: pointer;
  }

  .mail__copy:active {
    translate: 0 2px;
    box-shadow: none;
  }

  .mail__msg {
    margin: 16px 0 20px;
    font-size: clamp(18px, 1.5vw, 21px);
    line-height: 1.5;
  }

  .mail__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 859px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
