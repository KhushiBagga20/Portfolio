---
import Computer from './Computer.astro';
import ComingSoon from './ComingSoon.astro';
import SectionHead from './SectionHead.astro';
import { site } from '../data/site';

// Only links you've actually filled in (src/data/site.ts) show up.
const { email, resume } = site.links;
const links = [
  { label: 'email me', href: email ? `mailto:${email}` : '', external: false, tone: 'key--tomato' },
  { label: 'LinkedIn', href: site.links.linkedin, external: true, tone: '' },
  { label: 'GitHub', href: site.links.github, external: true, tone: '' },
  { label: 'résumé (PDF)', href: resume, external: true, tone: 'key--yellow' },
].filter((l) => l.href);
---

<section id="contact" class="section section--deep" aria-labelledby="contact-title">
  <div class="section__inner contact">
    <div class="contact__text">
      <SectionHead eyebrow="contact.eml" title="say hi" id="contact-title" />
      <p class="contact__msg">
        Building something unusual, running a hackathon, or want to talk about AI and design? I'd love to hear from you.
      </p>

      {
        email && (
          <p class="contact__email">
            <span class="contact__label">email</span>
            <a href={`mailto:${email}`}>{email}</a>
            <button class="contact__copy" type="button" data-copy={email}>
              copy
            </button>
          </p>
        )
      }

      {
        links.length ? (
          <div class="contact__links">
            {links.map((l) => (
              <a
                class:list={['key', l.tone]}
                href={l.href}
                target={l.external ? '_blank' : undefined}
                rel={l.external ? 'noopener' : undefined}
              >
                {l.label}
                {l.external && <span class="sr-only"> (opens in a new tab)</span>}
              </a>
            ))}
          </div>
        ) : (
          <ComingSoon text="contact links coming soon" />
        )
      }
    </div>

    <div class="contact__computer">
      <Computer resume={resume} />
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) =>
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy!);
        button.textContent = 'copied!';
      } catch {
        button.textContent = 'select it';
      }
      window.setTimeout(() => (button.textContent = 'copy'), 1800);
    }),
  );
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
  }

  .contact__msg {
    max-width: 38ch;
    margin: 22px 0 0;
    font-size: clamp(18px, 1.5vw, 21px);
    line-height: 1.5;
  }

  .contact__email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 22px 0 0;
    font-weight: 650;
  }

  .contact__label {
    color: var(--ink-soft);
    font: 400 11px/1 var(--font-pixel);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .contact__email a {
    word-break: break-all;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .contact__copy {
    padding: 4px 9px 3px;
    border: 2px solid var(--ink);
    border-radius: 6px;
    background: var(--cream);
    box-shadow: 0 2px 0 var(--ink);
    color: var(--ink);
    font: 400 10px/1.2 var(--font-pixel);
    text-transform: uppercase;
    cursor: pointer;
  }

  .contact__copy:active {
    translate: 0 2px;
    box-shadow: none;
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  .contact__computer {
    width: min(100%, 560px);
    justify-self: center;
  }

  @media (max-width: 859px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
    }

    .contact__computer {
      order: -1;
      width: min(100%, 440px);
      margin-top: -12px;
    }

    .contact__text {
      order: -2;
    }
  }
</style>
