---
interface Props {
  eyebrow: string;
  title: string;
  id: string;
  lede?: string;
  fill?: 'lemon' | 'cream' | 'mint' | 'lilac';
}

const { eyebrow, title, id, lede, fill = 'lemon' } = Astro.props;
---

<header class="head">
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id} class="title" style={`--fill: var(--${fill})`}>{title}</h2>
  {lede && <p class="lede">{lede}</p>}
</header>

<style>
  .eyebrow {
    margin: 0;
    font: 400 11px/1 var(--font-pixel);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .title {
    margin: 12px 0 0;
    color: var(--fill);
    font: 400 clamp(42px, 5.2vw, 84px) / 0.92 var(--font-display);
    -webkit-text-stroke: 0.07em var(--ink);
    paint-order: stroke fill;
    text-shadow:
      0.035em 0.045em 0 var(--ink),
      0.065em 0.08em 0 var(--tomato);
  }

  .lede {
    max-width: 54ch;
    margin: 20px 0 0;
    color: var(--text-soft);
    font-size: clamp(17px, 1.35vw, 20px);
  }

  :global(.is-arrived) .title {
    animation: arrive 0.8s var(--spring);
  }

  @keyframes arrive {
    0% {
      transform: translateY(16px) rotate(-3deg);
    }
    50% {
      transform: translateY(-4px) rotate(1deg);
    }
  }
</style>
