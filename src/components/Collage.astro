---
import { getImage } from 'astro:assets';
import { collage } from '../data/collage';
import { FULL, maskGeometry, maskStatic, type MaskLayer } from '../scripts/collage-math';

const widths = [640, 960, 1280, 1600];
const sizes = '(max-width: 899px) 78vw, 40vw';
const photo = await getImage({ src: collage.photo.src, widths, format: 'webp', quality: 80 });
const drawing = await getImage({ src: collage.illustration.src, widths, format: 'webp', quality: 88 });

const hidden = (h: { cx: number; cy: number }) => ({ cx: h.cx, cy: h.cy, s: 0 });
const center = { cx: 400, cy: 500 };

// First frame, before any JS: act 1, holes open.
const firstFrame: MaskLayer[] = [
  ...collage.drawingWindows.map(hidden),
  hidden(center),
  FULL,
  ...collage.photoWindows,
  hidden(center),
];
const stat = maskStatic(collage.drawingWindows.length + 1, collage.photoWindows.length + 1);
const geo = maskGeometry(firstFrame);
const maskStyle = [
  `--sheet:${collage.sheet}`,
  `-webkit-mask-image:${stat.image}`,
  `mask-image:${stat.image}`,
  `-webkit-mask-composite:${stat.webkitComposite}`,
  `mask-composite:${stat.composite}`,
  `-webkit-mask-position:${geo.position}`,
  `mask-position:${geo.position}`,
  `-webkit-mask-size:${geo.size}`,
  `mask-size:${geo.size}`,
].join(';');

const config = {
  photoWindows: collage.photoWindows,
  drawingWindows: collage.drawingWindows,
  lensSize: collage.lensSize,
  files: [collage.illustration.file, collage.photo.file, 'khushi_both.psd'],
};
---

<figure class="collage" data-collage data-config={JSON.stringify(config)}>
  <div class="card">
    <div class="frame" data-frame>
      <div class="layer" data-photo>
        <img
          src={photo.src}
          srcset={photo.srcSet.attribute}
          sizes={sizes}
          width="800"
          height="1000"
          alt={collage.photo.alt}
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="sheet" data-sheet style={maskStyle}>
        <div class="layer" data-drawing>
          <img
            src={drawing.src}
            srcset={drawing.srcSet.attribute}
            sizes={sizes}
            width="800"
            height="1000"
            alt={collage.illustration.alt}
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
      <svg class="marks" data-marks viewBox="0 0 800 1000" preserveAspectRatio="none" aria-hidden="true"></svg>
    </div>
    <figcaption class="label">
      <span class="label__rec" aria-hidden="true"><i></i>live</span>
      <span class="label__file" data-file>{config.files[0]}</span>
    </figcaption>
  </div>
</figure>

<style>
  .collage {
    --tilt: 2.5deg;
    position: relative;
    margin: 0;
    width: 100%;
    rotate: var(--tilt);
  }

  .card {
    padding: clamp(8px, 1.2vw, 13px) clamp(8px, 1.2vw, 13px) 0;
    border: var(--line) solid var(--ink);
    border-radius: 20px;
    background: var(--cream);
    box-shadow: clamp(7px, 1vw, 13px) clamp(8px, 1.1vw, 15px) 0 var(--ink);
  }

  .frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: var(--line) solid var(--ink);
    border-radius: 10px;
    background: var(--ink);
    isolation: isolate;
    touch-action: pan-y;
  }

  @media (hover: hover) and (pointer: fine) {
    .frame {
      cursor: crosshair;
    }
  }

  .layer {
    position: absolute;
    inset: 0;
    transform: scale(1.04);
    will-change: transform;
  }

  .layer img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }

  .sheet {
    position: absolute;
    inset: 0;
    background: var(--sheet);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  .marks {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .marks :global(.lines) {
    fill: none;
    stroke: var(--cream);
    stroke-width: 2px;
  }

  .marks :global(.shade) {
    fill: var(--ink);
    opacity: 0.32;
  }

  .label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 4px 12px;
    font: 400 clamp(9px, 0.8vw, 11px) / 1 var(--font-pixel);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .label__rec {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-soft);
  }

  .label__rec i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--pink);
    animation: blink 1.4s steps(2, jump-none) infinite;
  }

  @keyframes blink {
    to {
      opacity: 0.2;
    }
  }

  /* Hidden until the images are decoded, then it pops in (JS only). */
  :global(.js) .collage {
    opacity: 0;
    scale: 0.92;
    rotate: -4deg;
  }

  :global(.js) .collage.is-ready {
    opacity: 1;
    scale: 1;
    rotate: var(--tilt);
    transition:
      opacity 0.3s ease,
      scale 0.9s var(--spring),
      rotate 0.9s var(--spring);
  }
</style>
