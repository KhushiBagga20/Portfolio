---
import KeyboardScene from './KeyboardScene.astro';
import { desk, pad, sections } from '../data/keyboard';
---

<section id="keyboard" class="keyboard" aria-labelledby="keyboard-title">
  <div class="scene">
    <KeyboardScene scene={desk} class="scene__desk" />
    <KeyboardScene scene={pad} fit="meet" class="scene__pad" />
  </div>

  <div class="head">
    <p class="eyebrow">chapter 02 · explore</p>
    <h2 id="keyboard-title">press a key</h2>
    <div class="screen" data-screen aria-hidden="true">
      <span class="screen__prompt">&gt;</span>
      <span class="screen__text" data-typed></span>
      <span class="screen__cursor"></span>
    </div>
    <p class="hint hint--desk">
      or type {sections.map((s) => <kbd>{s.key}</kbd>)} on your own keyboard
    </p>
    <p class="hint hint--desk psst">(psst… spell hello)</p>
    <p class="hint hint--pad">tap a colourful key</p>
    <p class="hint hint--pad psst">(psst… the ✦ key does something)</p>
  </div>
</section>

<script>
  import { initKeyboard } from '../scripts/keyboard';
  document.querySelectorAll<SVGSVGElement>('svg[data-kb]').forEach(initKeyboard);
</script>

<style>
  .keyboard {
    position: relative;
    min-height: max(700px, 100svh);
    overflow: clip;
    border-top: var(--line) solid var(--ink);
    background:
      radial-gradient(90% 70% at 62% 42%, rgb(255 255 255 / 0.32), transparent 70%),
      var(--paper-deep);
  }

  .scene {
    position: absolute;
    inset: 0;
  }

  .scene :global(.scene__desk) {
    width: 100%;
    height: 100%;
  }

  .scene :global(.scene__pad) {
    display: none;
  }

  .head {
    position: absolute;
    left: var(--gutter);
    bottom: clamp(28px, 7vh, 72px);
    z-index: 2;
    max-width: 34ch;
    pointer-events: none;
  }

  .eyebrow {
    margin: 0;
    font: 400 11px/1 var(--font-pixel);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h2 {
    margin: 10px 0 0;
    color: var(--cream);
    font: 400 clamp(44px, 4.8vw, 84px) / 0.9 var(--font-display);
    white-space: nowrap;
    -webkit-text-stroke: 0.07em var(--ink);
    paint-order: stroke fill;
    text-shadow:
      0.035em 0.045em 0 var(--ink),
      0.065em 0.08em 0 var(--tomato);
  }

  .screen {
    display: flex;
    align-items: center;
    gap: 8px;
    width: min(320px, 100%);
    height: 48px;
    margin-top: 18px;
    padding: 0 16px;
    border: var(--line) solid var(--ink);
    border-radius: 12px;
    background: #211b36;
    box-shadow:
      inset 0 0 0 4px #302a4d,
      0 5px 0 var(--ink);
    color: var(--mint);
    font: 400 16px/1 var(--font-pixel);
    letter-spacing: 0.06em;
    text-shadow: 0 0 10px rgb(127 224 176 / 0.55);
  }

  .screen__prompt {
    color: var(--lemon);
  }

  .screen__text {
    overflow: hidden;
    white-space: pre;
  }

  .screen__cursor {
    flex: none;
    width: 10px;
    height: 18px;
    background: currentColor;
    animation: cursor 1s steps(2, jump-none) infinite;
  }

  @keyframes cursor {
    to {
      opacity: 0;
    }
  }

  .screen.is-party {
    animation: party 0.5s linear 5;
  }

  .screen.is-party .screen__text {
    color: var(--lemon);
  }

  @keyframes party {
    0%,
    100% {
      border-color: var(--pink);
    }
    33% {
      border-color: var(--lemon);
    }
    66% {
      border-color: var(--mint);
    }
  }

  .hint {
    margin: 14px 0 0;
    font: 400 24px/1.3 var(--font-hand);
  }

  .hint--pad {
    display: none;
  }

  .psst {
    margin-top: 2px;
    font-size: 19px;
    opacity: 0.75;
    rotate: -2deg;
    width: max-content;
  }

  kbd {
    display: inline-block;
    margin: 0 2px;
    padding: 4px 6px 3px;
    border: 2px solid var(--ink);
    border-radius: 6px;
    background: var(--cream);
    box-shadow: 0 2px 0 var(--ink);
    font: 400 11px/1 var(--font-pixel);
    vertical-align: 3px;
  }

  @media (max-width: 699px) {
    .keyboard {
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding: 56px var(--gutter) 28px;
    }

    .scene {
      position: relative;
      inset: auto;
    }

    .scene :global(.scene__desk),
    .hint--desk {
      display: none;
    }

    .scene :global(.scene__pad) {
      display: block;
      width: 100%;
      height: auto;
      margin-top: 28px;
    }

    .head {
      position: relative;
      left: auto;
      bottom: auto;
      order: -1;
      max-width: none;
      margin-bottom: 8px;
    }

    .hint--pad {
      display: block;
    }
  }
</style>
